    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "puppeteer": "^19.2.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.3",
    "typeorm": "^0.3.17",
    "undici": "^7.16.0",
    "vm2": "^3.9.19",
    "winston-daily-rotate-file": "^4.7.1",
