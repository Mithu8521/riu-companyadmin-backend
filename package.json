{
  "name": "RIU",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "rebuild:qa": "rimraf dist && NODE_ENV=qa nest build && npm run copy:assets && NODE_ENV=qa node dist/src/main.js",
    "prebuild": "rimraf dist",
    "build:qa": "NODE_ENV=qa nest build && npm run copy:assets",
    "build:uat": "NODE_ENV=uat nest build",
    "build:prod": "NODE_ENV=prod nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:build:qa": "NODE_ENV=qa node dist/src/main.js",
    "start:build:qapm2": "NODE_ENV=qa pm2 start dist/src/main.js --name my-qa-app-name",
    "start:build:uat": "NODE_ENV=uat node dist/src/main.js",
    "start:build:prod": "NODE_ENV=prod node dist/src/main.js",
    "start": "NODE_ENV=dev nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "build": "tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "cpx 'src/public/**' 'dist/src/public'",
    "migrate-reporting-documents": "NODE_ENV=qa ts-node -r tsconfig-paths/register src/scripts/migrate-reporting-documents.ts",
    "migrate-sector-documents": "NODE_ENV=qa ts-node -r tsconfig-paths/register src/scripts/migrate-sector-documents.ts",
    "migrate-manipal-tabular-to-trends": "NODE_ENV=qa ts-node -r tsconfig-paths/register src/scripts/migrate-manipal-tabular-to-trends.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.1",
    "@azure/storage-blob": "^12.26.0",
    "@nestjs/axios": "^3.0.1",
