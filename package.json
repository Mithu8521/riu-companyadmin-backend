    "cpx": "^1.5.0",
    "date-fns": "^4.1.0",
    "docx": "^9.2.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "fs": "^0.0.1-security",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
