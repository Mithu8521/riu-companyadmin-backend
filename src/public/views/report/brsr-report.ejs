<%# Kennametal India Limited BRSR Report Template - Exact match to the provided image %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kennametal India Limited - BRSR Report</title>
    <!-- <style media="print"> -->
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 11px;
            line-height: 1.3;
            color: #000000;
            margin: 0;
            padding: 0;
        }
        .container {
            margin: 0 auto;
            padding: 0px;
        }
        .header {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 15px;
        }
        .title-section {
            text-align: center;
            margin-bottom: 22px;
        }
        .annexure-title {
            font-size: 15px;
            margin-bottom: 5px;
        }
        .main-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .section-header {
            background-color: #f5f5f5;
            margin-bottom: 10px;
            font-size: 12px;
            font-weight: bold;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        .details-table td {
            padding: 4px;
            vertical-align: top;
            border: none;
        }
        .details-table tr:not(:last-child) td {
            border-bottom: 1px solid #eee;
        }
        .number-col {
            width: 5%;
        }
        .label-col {
            width: 45%;
        }
        .value-col {
            width: 50%;
        }
        .divider-line {
            border-top: 1px solid #000;
            margin: 15px 0;
        }
        .two-column-section {
            display: flex;
            width: 100%;
        }
        .left-column {
            width: 50%;
            padding-right: 10px;
        }
        .right-column {
            width: 50%;
            padding-left: 10px;
        }
        .section-title {
            display: flex;
            margin-bottom: 10px;
        }
        .section-number {
            width: 5%;
            font-weight: bold;
        }
        .section-name {
            width: 95%;
            font-weight: bold;
        }
        .item-title {
            display: flex;
            margin-bottom: 5px;
        }
        .item-number {
            width: 5%;
        }
        .item-name {
            width: 95%;
        }
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            font-size: 12px;
        }
        .data-table th, .data-table td {
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
            border-right: 1px solid #000;
            padding: 4px;
            text-align: left;
            word-break: break-word; 
            white-space: normal;
            vertical-align: top;
        }
        .border-right-none {
            border-right: none !important;
        }
        .text-center {
            text-align: center !important;
        }
        .indented {
            margin-left: 20px;
        }
        .note {
            font-size: 12px;
            margin-top: 3px;
        }
        .font-bold {
            font-weight: bold;
        }
        .footer {
            margin-top: 20px;
            display: flex;
            align-items: center;
        }
        .yellow-bar {
            background-color: #ffcc00;
            height: 10px;
            width: 100%;
            margin-bottom: 8px;
        }
        .page-number {
            text-align: center;
            font-size: 12px;
            width: 100%;
        }
        .leadership-indicators {
            display: <%- (showLeadershipIndicators ? 'block' : 'none') %>;
        }
        thead, thead tr, thead tr th, thead tr td, thead th, thead td {
            page-break-inside: avoid;
            page-break-after: avoid;
            font-weight: bold;
        }
        tbody tr th, tbody th {
            font-weight: bold;
        }
        .avoid-page-break-before {
            page-break-before: avoid;
        }
        .aviod-page-break-inside {
            page-break-inside: avoid;
        }
    </style>
</head>
<body>
    <div class="container">

        <!-- Title Section -->
        <div class="title-section">
            <div class="main-title">Business Responsibility and Sustainability Reporting</div>
        </div>

        <% let row; let col; %>

        <div class="section-header font-bold">Section A: General disclosures</div>

        <div style="display: flex; margin-bottom: 5px;" class="font-bold avoid-page-break-before">
            <div style="width: 3%;">I.</div>
            <div style="width: 97%;">Details of the listed entity</div>
        </div>

        <div style="margin-left: 15px;" class="avoid-page-break-before">
            <div style="display: flex; margin: 4px 0;" class="avoid-page-break-before">
                <div style="width: 3%;">1.</div>
                <div style="width: 46%;" class="font-bold">Corporate Identity Number (CIN) of the Listed Entity</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ1.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">2.</div>
                <div style="width: 46%;" class="font-bold">Name of the Listed Entity</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ2.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">3.</div>
                <div style="width: 46%;" class="font-bold">Year of incorporation</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ3.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">4.</div>
                <div style="width: 46%;" class="font-bold">Registered office address</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ4.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">5.</div>
                <div style="width: 46%;" class="font-bold">Corporate address</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ5.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">6.</div>
                <div style="width: 46%;" class="font-bold">E-mail</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ6.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">7.</div>
                <div style="width: 46%;" class="font-bold">Telephone</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ7.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">8.</div>
                <div style="width: 46%;" class="font-bold">Website</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ8.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">9.</div>
                <div style="width: 46%;" class="font-bold">Financial year for which reporting is being done</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;">
                    <div><%- SQ9.value %></div>
                </div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">10.</div>
                <div style="width: 46%;" class="font-bold">Name of the Stock Exchange(s) where shares are listed</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ10.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">11.</div>
                <div style="width: 46%;" class="font-bold">Paid-up Capital</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ11.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">12.</div>
                <div style="width: 46%;" class="font-bold">Name and contact details (telephone, email address) of the person who may be contacted in case of any queries on the BRSR report</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;">
                    <div>
                        DIN: <%- SQ12.value[0][0] %>
                    </div>
                    <div>
                        <%- SQ12.value[1][0] %>
                    </div>
                    <div>
                        <%- SQ12.value[2][0] %>
                    </div>
                    <div>
                        <%- SQ12.value[3][0] %>
                    </div>
                    <div>
                        <%- SQ12.value[4][0] %>
                    </div>
                </div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">13.</div>
                <div style="width: 46%;" class="font-bold">Reporting boundary - Are the disclosures under this report made on a standalone basis (i.e. only for the entity) or on a consolidated basis (i.e. for the entity and all the entities which form a part of its consolidated financial statements, taken together).</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ13.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">14.</div>
                <div style="width: 46%;" class="font-bold">Name of assurance provider</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ1023.value %></div></div>
            </div>

            <div style="display: flex; margin: 4px 0;">
                <div style="width: 3%;">15.</div>
                <div style="width: 46%;" class="font-bold">Type of assurance obtained</div>
                <div style="width: 2%;"> : </div>
                <div style="width: 49%;"><div><%- SQ1024.value %></div></div>
            </div>
        </div>

        <div class="divider-line avoid-page-break-before"></div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold">
            <div style="width: 3%;">II.</div>
            <div style="width: 97%;">Products/Services</div>
        </div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold avoid-page-break-before aviod-page-break-inside">
            <div style="width: 3%;">16.</div>
            <div style="width: 97%;">Details of business activities (accounting for 90% of the turnover):</div>
        </div>

        <div style="width: 100%; margin-bottom: 10px; margin-left: 3%;" class="avoid-page-break-before">
            <table class="data-table avoid-page-break-before">
                <thead class="font-bold">
                    <tr>
                        <th>Sl. No.</th>
                        <th>Description of Main Activity</th>
                        <th>Description of Business Activity</th>
                        <th class="border-right-none">% of Turnover of the entity</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (SQ14.value && SQ14.value.length > 0) { %>
                        <% SQ14.value.forEach((row, index) => { %>
                            <tr>
                                <td><%- index + 1 %>.</td>
                                <td><%- row[0] %></td>
                                <td><%- row[1] %></td>
                                <td class="border-right-none text-center"><%- row[2] %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center border-right-none">No Data</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <% if (SQ14 && SQ14?.note && SQ14.note !== 'undefined') { %>
                <div style="margin-bottom:10px;" class="avoid-page-break-before aviod-page-break-inside">
                    <%- SQ14.note %>
                </div>
            <% } %>
        </div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
            <div style="width: 3%;">17.</div>
            <div style="width: 97%;">Products/Services sold by the entity (accounting for 90% of the entity's Turnover):</div>
        </div>

        <div style="width: 100%; margin-bottom: 10px; margin-left: 3%;" class="avoid-page-break-before">
            <table class="data-table avoid-page-break-before">
                <thead>
                    <tr>
                        <th>Sl. No.</th>
                        <th>Product/Service</th>
                        <th class="text-center">NIC Code</th>
                        <th class="text-center border-right-none">% of total Turnover contributed</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof SQ15 !== 'undefined' && SQ15.value && SQ15.value.length > 0) { %>
                        <% SQ15.value.forEach((row, index) => { %>
                            <tr>
                                <td><%- index + 1 %>.</td>
                                <td><%- row[0] %></td>
                                <td class="text-center"><%- row[1] %></td>
                                <td class="border-right-none text-center"><%- row[2] %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center  border-right-none">No Data</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (SQ15 && SQ15?.note && SQ15.note !== 'undefined') { %>
                <div style="margin-bottom:10px;" class="avoid-page-break-before aviod-page-break-inside">
                    <%- SQ15.note %>
                </div>
            <% } %>
        </div>

                
        <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
            <div style="width: 3%;">III.</div>
            <div style="width: 97%;">Operations</div>
        </div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold avoid-page-break-before aviod-page-break-inside">
            <div style="width: 3%;">18.</div>
            <div style="width: 97%;">Number of locations where plants and/or operations/offices of the entity are situated:</div>
        </div>

        <div style="width: 100%; margin-bottom: 10px; margin-left: 3%;" class="avoid-page-break-before aviod-page-break-inside">
            <table class="data-table avoid-page-break-before">
                <thead>
                    <tr>
                        <th style="width: 25%;">Location</td>
                        <th class="text-center" style="width: 25%;">Number of plants</th>
                        <th class="text-center" style="width: 25%;">Number of offices</th>
                        <th class="border-right-none text-center" style="width: 25%;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>National</th>
                        <td class="text-center"><%- SQ16.value[0][0] %></td>
                        <td class="text-center"><%- SQ16.value[0][1] %></td>
                        <td class="border-right-none text-center"><%- SQ16.value[0][2] %></td>
                    </tr>
                    <tr>
                        <th class="font-bold">International*</th>
                        <td class="text-center"><%- SQ16.value[1][0] %></td>
                        <td class="text-center"><%- SQ16.value[1][1] %></td>
                        <td class="border-right-none text-center"><%- SQ16.value[1][2] %></td>
                    </tr>
                </tbody>
            </table>
            
            <% if (SQ16 && SQ16?.note && SQ16.note !== 'undefined') { %>
                <div style="margin-bottom:10px;" class="avoid-page-break-before aviod-page-break-inside">
                    <%- SQ16.note %>
                </div>
            <% } %>
        </div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
            <div style="width: 3%;">19.</div>
            <div style="width: 97%;">Markets served by the entity:</div>
        </div>

        <div style="width: 100%; margin-bottom: 10px; margin-left: 3%;" class="avoid-page-break-before">
            <div style="width: 97%; margin-bottom: 10px;" class="font-bold avoid-page-break-before">a. No. of locations</div>
            <div style="width: 97%; margin-bottom: 10px;" class="avoid-page-break-before">
                <table class="data-table avoid-page-break-before aviod-page-break-inside">
                    <tbody>
                        <tr>
                            <td class="font-bold" style="width: 60%;">Locations</td>
                            <td class="text-center border-right-none">No.</td>
                        </tr>
                        <tr>
                            <td class="font-bold">National (No. of states)</td>
                            <td class="text-center border-right-none"><%- SQ17.value[0][0] %></td>
                        </tr>
                        <tr>
                            <td class="font-bold">International (No. of countries)</td>
                            <td class="text-center border-right-none"><%- SQ17.value[1][0] %></td>
                        </tr>
                    </tbody>
                </table>

                
                <% if (SQ17 && SQ17?.note && SQ17.note !== 'undefined') { %>
                    <div style="margin-bottom:10px;" class="avoid-page-break-before aviod-page-break-inside">
                        <%- SQ17.note %>
                    </div>
                <% } %>
            </div>

            <div style="margin-bottom: 10px; width: 97%;">
                <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
                    <div style="width: 3%;">b.</div>
                    <div style="width: 97%;">What is the contribution of exports as a percentage of the total turnover of the entity?</div>
                </div>
                <div style="margin-bottom: 10px; margin-left: 3%;  line-height: 1.4;" class="avoid-page-break-before">
                    <%- SQ18.value %>
                </div>

                <% if (SQ18 && SQ18?.note && SQ18.note !== 'undefined') { %>
                    <div style="margin-bottom:10px; margin-left: 3%;" class="avoid-page-break-before aviod-page-break-inside">
                        <%- SQ18.note %>
                    </div>
                <% } %>
            </div>

            <div style="margin-bottom: 10px; width: 97%;">
                <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
                    <div style="width: 3%;">c.</div>
                    <div style="width: 97%;">A brief on type of customers</div>
                </div>
                <div style="margin-bottom: 10px; margin-left: 3%;  line-height: 1.4;" class="avoid-page-break-before">
                    <%- SQ19.value %>
                </div>

                <% if (SQ19 && SQ19?.note && SQ19.note !== 'undefined') { %>
                    <div style="margin-bottom:10px; margin-left: 3%;" class="avoid-page-break-before aviod-page-break-inside">
                        <%- SQ19.note %>
                    </div>
                <% } %>
            </div>
        </div>


        <!-- Section IV: Employees -->
        <div style="display: flex; margin-bottom: 10px;" class="font-bold aviod-page-break-inside">
            <div style="width: 3%;">IV.</div>
            <div style="width: 97%;">Employees</div>
        </div>

        <div style="display: flex; margin-bottom: 10px;" class="font-bold avoid-page-break-before aviod-page-break-inside">
            <div style="width: 3%;">20.</div>
            <div style="width: 97%;">Details as at the end of the Financial Year:</div>
        </div>

        <div style="margin-bottom: 10px; margin-left: 3%;" class="avoid-page-break-before">
            <!-- a. Employees and workers (including differently abled) -->
            <table class="data-table avoid-page-break-before">
                <thead>
                    <tr><th colspan="100" class="border-right-none">a. Employees and workers (including differently abled):</th></tr>
                    <tr>
                        <th>S. No.</th>
                        <th>Particulars</th>
                        <th class="text-center" style="width: 15%;">Total (A)</th>
                        <th colspan="2" class="text-center" style="width: 30%;">Male</th>
                        <th colspan="2" class="text-center border-right-none" style="width: 30%;">Female</th>
                    </tr>
                    <tr>
                        <th></th><th></th><th></th>
                        <th class="text-center" style="width: 15%;">No. (B)</th>
                        <th class="text-center" style="width: 15%;">% (B/A)</th>
                        <th class="text-center" style="width: 15%;">No. (C)</th>
                        <th class="text-center border-right-none" style="width: 15%;">% (C/A)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th colspan="100" class="border-right-none text-center font-bold">Employees</th></tr>
                    <tr class="avoid-page-break-before">
                        <td>1.</td><td>Permanent Employees (D)</td>
                        <td class="text-center"><%- SQ20.value[1][0] %></td>
                        <td class="text-center"><%- SQ20.value[1][1] %></td>
                        <td class="text-center"><%- SQ20.value[1][2] %></td>
                        <td class="text-center"><%- SQ20.value[1][3] %></td>
                        <td class="text-center border-right-none"><%- SQ20.value[1][4] %></td>
                    </tr>
                    <tr>
                        <td>2.</td><td>Other than Permanent (E)</td>
                        <td class="text-center"><%- SQ20.value[2][0] %></td>
                        <td class="text-center"><%- SQ20.value[2][1] %></td>
                        <td class="text-center"><%- SQ20.value[2][2] %></td>
                        <td class="text-center"><%- SQ20.value[2][3] %></td>
                        <td class="text-center border-right-none"><%- SQ20.value[2][4] %></td>
                    </tr>
                    <tr>
                        <td>3.</td><th>Total Employees (D + E)</th>
                        <td class="text-center font-bold"><%- SQ20.value[3][0] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[3][1] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[3][2] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[3][3] %></td>
                        <td class="text-center border-right-none font-bold"><%- SQ20.value[3][4] %></td>
                    </tr>
                    <tr><th colspan="100" class="border-right-none text-center">Workers</th></tr>
                    <tr class="avoid-page-break-before">
                        <td>4.</td><td>Permanent Workers (F)</td>
                        <td class="text-center"><%- SQ20.value[5][0] %></td>
                        <td class="text-center"><%- SQ20.value[5][1] %></td>
                        <td class="text-center"><%- SQ20.value[5][2] %></td>
                        <td class="text-center"><%- SQ20.value[5][3] %></td>
                        <td class="text-center border-right-none"><%- SQ20.value[5][4] %></td>
                    </tr>
                    <tr>
                        <td>5.</td><td>Other than Permanent (G)</td>
                        <td class="text-center"><%- SQ20.value[6][0] %></td>
                        <td class="text-center"><%- SQ20.value[6][1] %></td>
                        <td class="text-center"><%- SQ20.value[6][2] %></td>
                        <td class="text-center"><%- SQ20.value[6][3] %></td>
                        <td class="text-center border-right-none"><%- SQ20.value[6][4] %></td>
                    </tr>
                    <tr>
                        <td>6.</td><th>Total Workers (F + G)</th>
                        <td class="text-center font-bold"><%- SQ20.value[7][0] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[7][1] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[7][2] %></td>
                        <td class="text-center font-bold"><%- SQ20.value[7][3] %></td>
                        <td class="text-center border-right-none font-bold"><%- SQ20.value[7][4] %></td>
                    </tr>
                </tbody>
            </table>

            
            <% if (SQ20 && SQ20?.note && SQ20.note !== 'undefined') { %>
                <div style="margin-bottom:10px;" class="avoid-page-break-before aviod-page-break-inside">
                    <%- SQ20.note %>
                </div>
            <% } %>

            <!-- b. Differently abled Employees and Workers -->
            <table class="data-table">
                <thead>
                    <tr><th colspan="100" class="border-right-none">b. Differently abled Employees and workers:</th></tr>
                    <tr>
                        <th>S. No.</th>
                        <th>Particulars</th>
                        <th class="text-center" style="width: 15%;">Total (A)</th>
                        <th colspan="2" class="text-center" style="width: 30%;">Male</th>
